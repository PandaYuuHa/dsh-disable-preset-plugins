{
  "name": "@pandayuuha/dsh-disable-preset-plugins",
  "version": "0.1.0",
  "description": "Disable specific plugins in agent presets (standard, ptc, minimal, etc.) via configuration",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "preset"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pandayuuha/dsh-disable-preset-plugins.git"
  },
  "homepage": "https://github.com/pandayuuha/dsh-disable-preset-plugins#readme",
  "bugs": {
    "url": "https://github.com/pandayuuha/dsh-disable-preset-plugins/issues"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent-preset": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
